# ==============================================================================
# Google Production Grade Multi-Stage Dockerfile for Strapi License Server
# ==============================================================================

# Stage 1: Build & Assets Compilation
FROM node:22-alpine AS builder

RUN apk add --no-cache \
    build-base \
    gcc \
    autoconf \
    automake \
    libtool \
    make \
    python3 \
    git \
    openssl

WORKDIR /opt/app

ENV NODE_ENV=production

COPY package.json package-lock.json* ./

RUN npm install --legacy-peer-deps --ignore-scripts

RUN npm rebuild better-sqlite3

COPY . .

RUN node scripts/sync-customer-vendor-assets.js
RUN npm run build

# Stage 2: Hardened Minimal Production Image
FROM node:22-alpine AS runner

RUN apk add --no-cache \
    tini \
    openssl \
    ca-certificates

ENV NODE_ENV=production
ENV PORT=1337
ENV HOST=0.0.0.0

WORKDIR /opt/app

# Run as unprivileged node user (UID 1000)
COPY --from=builder --chown=node:node /opt/app/package.json ./package.json
COPY --from=builder --chown=node:node /opt/app/node_modules ./node_modules
COPY --from=builder --chown=node:node /opt/app/dist ./dist
COPY --from=builder --chown=node:node /opt/app/public ./public
COPY --from=builder --chown=node:node /opt/app/config ./config
COPY --from=builder --chown=node:node /opt/app/src ./src
COPY --from=builder --chown=node:node /opt/app/plugins ./plugins
COPY --from=builder --chown=node:node /opt/app/index.js ./index.js
COPY --from=builder --chown=node:node /opt/app/tsconfig.json ./tsconfig.json

USER node

EXPOSE 1337

HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 \
  CMD wget -qO- http://127.0.0.1:1337/api/license-server/healthz || exit 1

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["npm", "run", "start"]
