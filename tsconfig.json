{
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "target": "ES2022",
    "types": ["bun", "node"],
    "strict": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "incremental": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "outDir": "./dist",
    "rootDir": "./"
  },
  "include": [
    "./src/**/*",
    "./config/**/*",
    "./plugins/**/*",
    "./types/**/*",
    "./tests/**/*",
    "./index.js"
  ],
  "exclude": [
    "node_modules",
    "build",
    "dist",
    ".tmp",
    "apps"
  ]
}
