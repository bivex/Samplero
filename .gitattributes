# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Force LF on all source code files
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.go text eol=lf
*.rs text eol=lf
*.dart text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf

# Explicit binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.dylib binary
*.so binary
*.dll binary
*.p12 binary
*.pfx binary
*.db binary
*.sqlite binary
*.sqlite3 binary
