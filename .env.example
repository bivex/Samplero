# ==============================================================================
# SAMPLERO VST & SAMPLES LICENSE SERVER — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and populate with cryptographically secure random values.
# In production, NEVER commit the .env file or sensitive keys into source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & RUNTIME
# ------------------------------------------------------------------------------
NODE_ENV=production
HOST=0.0.0.0
PORT=1337
STRAPI_URL=https://api.yourdomain.com
CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com,tauri://localhost

# Initial Bootstrap (Optional: used only during first-time database provisioning)
SEED_SAMPLE_DATA=false
ADMIN_INITIAL_EMAIL=admin@yourdomain.com
ADMIN_INITIAL_PASSWORD=GenerateStrongPasswordHere123!@#
ADMIN_INITIAL_FIRSTNAME=System
ADMIN_INITIAL_LASTNAME=Administrator

# ------------------------------------------------------------------------------
# 2. CORE SECURITY & APPLICATION KEYS
# Generate 32+ byte random base64 strings: openssl rand -base64 32
# ------------------------------------------------------------------------------
APP_KEYS=randomBase64Key1==,randomBase64Key2==,randomBase64Key3==,randomBase64Key4==
API_TOKEN_SALT=randomBase64SaltForApiTokens==
ADMIN_JWT_SECRET=randomBase64AdminJwtSecret==
TRANSFER_TOKEN_SALT=randomBase64TransferTokenSalt==
JWT_SECRET=randomBase64UsersJwtSecret==
JWT_EXPIRESIN=30d

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (PostgreSQL Recommended)
# ------------------------------------------------------------------------------
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=license_server
DATABASE_USERNAME=strapi_user
DATABASE_PASSWORD=strong_database_password_here
DATABASE_SSL=false
DATABASE_SCHEMA=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# ------------------------------------------------------------------------------
# 4. REDIS (Caching, Nonce Freshness, Rate Limiting)
# ------------------------------------------------------------------------------
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ------------------------------------------------------------------------------
# 5. RATE LIMITING POLICY
# ------------------------------------------------------------------------------
RATE_LIMIT=100
RATE_LIMIT_INTERVAL=1m

# ------------------------------------------------------------------------------
# 6. S3 STORAGE (Downloadable VST Plugins & Sample Packs)
# ------------------------------------------------------------------------------
UPLOAD_PROVIDER=aws-s3
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=us-east-1
AWS_S3_BUCKET=samplero-production-assets
AWS_S3_ENDPOINT=
AWS_S3_SSL_ENABLED=true
AWS_S3_FORCE_PATH_STYLE=false
AWS_S3_SIGNATURE_VERSION=v4
AWS_S3_SIGNED_URL_EXPIRES=3600

# ------------------------------------------------------------------------------
# 7. MEILISEARCH (Product Search Indexing)
# ------------------------------------------------------------------------------
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_API_KEY=masterKey123
MEILISEARCH_REINDEX_ON_BOOTSTRAP=false
MEILISEARCH_PRODUCT_BATCH_LIMIT=1000
PRODUCT_SEARCH_MIN_QUERY_LENGTH=2
PRODUCT_SEARCH_CACHE_TTL_SECONDS=60

# ------------------------------------------------------------------------------
# 8. LICENSE SERVER & CRYPTOGRAPHIC ENGINE
# ------------------------------------------------------------------------------
LICENSE_SIGNER_MODE=remote
LICENSE_SIGNER_URL=http://127.0.0.1:8081
LICENSE_SIGNER_AUTH_TOKEN=openssl-rand-hex-32-signer-token
LICENSE_SIGNER_SHARED_SECRET=openssl-rand-hex-32-signer-shared-secret
LICENSE_SIGNER_TLS_CA_PATH=
LICENSE_SIGNER_TLS_CERT_PATH=
LICENSE_SIGNER_TLS_KEY_PATH=
LICENSE_SIGNER_FRESHNESS_MAX_SKEW_SECONDS=60
LICENSE_SIGNER_TIMEOUT_MS=5000

# HMAC secret for signing API JSON responses (x-response-signature)
LICENSE_SERVER_SECRET=openssl-rand-hex-32-response-signature-secret

# Endpoint advertised to VST plugins for mTLS validation/heartbeats
LICENSE_MTLS_ENDPOINT=https://api.yourdomain.com

# Licensing Business Logic
LICENSE_GRACE_PERIOD_DAYS=7
LICENSE_HEARTBEAT_HOURS=24
LICENSE_MAX_ACTIVATIONS=3
LICENSE_CERT_DAYS=365
LICENSE_NONCE_TTL=300
LICENSE_FRESHNESS_MAX_SKEW_SECONDS=300
LICENSE_REQUIRE_MTLS=true
LICENSE_REQUIRE_FRESHNESS_STORE=true
LICENSE_MOCK_AUTO_APPROVE_FIRST_ACTIVATION=false

# Payment Webhook Security
LICENSE_WEBHOOK_SECRET=openssl-rand-hex-32-webhook-secret
LICENSE_WEBHOOK_FRESHNESS_MAX_SKEW_SECONDS=300
LICENSE_WEBHOOK_ALLOWED_IPS=

# Nginx reverse-proxy to Strapi internal header authentication
LICENSE_PROXY_SHARED_SECRET=openssl-rand-hex-32-proxy-shared-secret

# ------------------------------------------------------------------------------
# 9. CERT-SIGNER MICROSERVICE CONFIGURATION (Go Daemon)
# ------------------------------------------------------------------------------
CERT_SIGNER_LISTEN_ADDR=:8081
CERT_SIGNER_BACKEND=local
CERT_SIGNER_CA_CERT_PATH=/etc/ssl/certs/intermediate-ca.crt
CERT_SIGNER_CA_CHAIN_PATH=/etc/ssl/certs/ca-chain.crt
CERT_SIGNER_CA_KEY_PATH=/etc/ssl/private/intermediate-ca.key
CERT_SIGNER_VALIDITY_DAYS=365
CERT_SIGNER_AUTH_MAX_SKEW=60s

# Step-CA (When CERT_SIGNER_BACKEND=stepca)
STEP_CA_URL=https://127.0.0.1:9000
STEP_CA_ROOT=/etc/step-ca/certs/root_ca.crt
STEP_CA_PROVISIONER=cert-signer
STEP_CA_PASSWORD=step-ca-provisioner-password-here

# ------------------------------------------------------------------------------
# 10. OBSERVABILITY & TELEMETRY
# ------------------------------------------------------------------------------
SENTRY_DSN=
METRICS_ENABLED=true
